{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "主角": {
      "type": "object",
      "properties": {
        "姓名": {
          "type": "string"
        },
        "身份": {
          "type": "string",
          "description": "苍家文官（单主角固定为 <user>）"
        },
        "性别": {
          "type": "string"
        },
        "年龄": {
          "type": "number"
        },
        "出身": {
          "type": "string",
          "description": "家世、门派或背景一句话"
        },
        "力量": {
          "type": "number"
        },
        "敏捷": {
          "type": "number"
        },
        "体质": {
          "type": "number"
        },
        "外貌": {
          "type": "number"
        },
        "智力": {
          "type": "number"
        },
        "意志": {
          "type": "number"
        },
        "教育": {
          "type": "number"
        },
        "体型": {
          "type": "number"
        },
        "幸运": {
          "type": "number"
        },
        "气血": {
          "default": {
            "当前": 10,
            "上限": 10
          },
          "type": "object",
          "properties": {
            "当前": {
              "type": "number"
            },
            "上限": {
              "type": "number"
            }
          },
          "required": [
            "当前",
            "上限"
          ]
        },
        "法力": {
          "default": {
            "当前": 10,
            "上限": 10
          },
          "type": "object",
          "properties": {
            "当前": {
              "type": "number"
            },
            "上限": {
              "type": "number"
            }
          },
          "required": [
            "当前",
            "上限"
          ]
        },
        "心神": {
          "default": {
            "当前": 50,
            "上限": 50
          },
          "type": "object",
          "properties": {
            "当前": {
              "type": "number"
            },
            "上限": {
              "type": "number"
            }
          },
          "required": [
            "当前",
            "上限"
          ]
        },
        "技能": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "技能名"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "等级": {
                "type": "number"
              },
              "本职": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "等级"
            ]
          }
        },
        "特长与加成": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "物品栏": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "物品名"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "描述": {
                "type": "string",
                "description": "物品外观与特性的简短描述"
              },
              "数量": {
                "type": "number"
              }
            },
            "required": [
              "描述",
              "数量"
            ]
          }
        }
      },
      "required": [
        "姓名",
        "身份",
        "性别",
        "年龄",
        "出身",
        "力量",
        "敏捷",
        "体质",
        "外貌",
        "智力",
        "意志",
        "教育",
        "体型",
        "幸运"
      ]
    },
    "剧情进度": {
      "type": "object",
      "properties": {
        "当前章节": {
          "type": "string",
          "enum": [
            "第一章·诏起龙庭",
            "第二章·龙泽听潮"
          ]
        },
        "当前日": {
          "default": 1,
          "type": "number"
        },
        "大祭首日": {
          "default": 0,
          "type": "number"
        },
        "当前场景": {
          "type": "string",
          "description": "章节内小场景关键名，如 接旨/桐淮派堂口/东市百年老槐/护国寺/阜财坊/城北高门/出山仪式"
        },
        "在场角色": {
          "description": "在场的 NPC 名数组，事件总线用 present() 容错包含匹配",
          "default": [],
          "$ref": "#/$defs/__schema0"
        },
        "地点": {
          "type": "string",
          "description": "场景_前缀条目名，由场景控制器读并 getwi 拉取"
        },
        "到达章节": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "仪式四物": {
          "default": {
            "向阳木心": false,
            "不灭灯油": false,
            "不落之尘": false,
            "清晨初露": false
          },
          "type": "object",
          "properties": {
            "向阳木心": {
              "default": false,
              "type": "boolean"
            },
            "不灭灯油": {
              "default": false,
              "type": "boolean"
            },
            "不落之尘": {
              "default": false,
              "type": "boolean"
            },
            "清晨初露": {
              "default": false,
              "type": "boolean"
            }
          }
        },
        "任务目标": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "目标名"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "描述": {
                "default": "",
                "type": "string"
              },
              "状态": {
                "default": "进行中",
                "type": "string",
                "enum": [
                  "进行中",
                  "已完成",
                  "已失败"
                ]
              }
            }
          }
        }
      },
      "required": [
        "当前章节",
        "当前场景",
        "地点"
      ]
    },
    "世界": {
      "type": "object",
      "properties": {
        "当前地点": {
          "type": "string"
        },
        "现实时间": {
          "type": "string",
          "description": "模组内时间，光熙三十年12月某日"
        },
        "天气": {
          "type": "string"
        },
        "现实日期推进": {
          "description": "从开局起经过的天数",
          "$ref": "#/$defs/__schema1"
        },
        "时段": {
          "default": "清晨",
          "type": "string",
          "enum": [
            "清晨",
            "上午",
            "午后",
            "黄昏",
            "夜晚",
            "深夜"
          ]
        }
      },
      "required": [
        "当前地点",
        "现实时间",
        "天气",
        "现实日期推进"
      ]
    },
    "NPC关系表": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "description": "NPC名"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "警惕度": {
            "type": "number"
          },
          "态度": {
            "type": "string",
            "enum": [
              "敌意",
              "戒备",
              "中立",
              "友善",
              "信任"
            ]
          },
          "好感": {
            "type": "number"
          },
          "存活": {
            "default": true,
            "type": "boolean"
          },
          "备注": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "警惕度",
          "态度",
          "好感"
        ]
      }
    },
    "秘密知晓": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "description": "秘密名"
      },
      "additionalProperties": {
        "default": false,
        "type": "boolean"
      }
    },
    "门": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "description": "门牌号"
      },
      "additionalProperties": {
        "default": true,
        "type": "boolean"
      }
    },
    "_本轮注入": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "order": {
            "default": 0,
            "type": "number"
          },
          "ts": {
            "default": 0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "body"
        ]
      }
    },
    "_rollLog": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "技能": {
            "type": "string"
          },
          "目标": {
            "default": 50,
            "type": "number"
          },
          "投出": {
            "default": 0,
            "type": "number"
          },
          "结果": {
            "type": "string"
          },
          "奖惩": {
            "default": 0,
            "type": "number"
          },
          "损失量": {
            "default": "",
            "type": "string"
          },
          "理由": {
            "default": "",
            "type": "string"
          },
          "来源": {
            "default": "玩家请求",
            "type": "string",
            "enum": [
              "主持请求",
              "玩家请求",
              "幸运翻盘",
              "强投"
            ]
          },
          "楼层": {
            "default": 0,
            "type": "number"
          },
          "ts": {
            "default": 0,
            "type": "number"
          }
        },
        "required": [
          "技能",
          "结果"
        ]
      }
    }
  },
  "required": [
    "主角",
    "剧情进度",
    "世界"
  ],
  "$defs": {
    "__schema0": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "__schema1": {
      "type": "number"
    }
  }
}